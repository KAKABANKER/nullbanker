generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  phone         String?
  password      String
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  orders        Order[]

  // Segurança de login
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?

  auditLogs     AuditLog[]
}

// Registro de ações administrativas sensíveis (quem fez o quê, quando e de onde).
model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String // ex: "order.status_update", "user.delete", "settings.update"
  targetType String? // ex: "Order", "User", "Product", "Settings"
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  shortDesc   String
  description String
  price       Float
  imageUrl    String?
  // images      String[] @default([]) // <--- COMENTE
  features    String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int?
  user              User?    @relation(fields: [userId], references: [id])
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  customerName      String
  customerEmail     String
  paymentMethod     String // "credit_card" | "pix"
  gateway           String? // "plumify" | "stripe" | "mercadopago"
  cardLast4         String?
  cardBrand         String?
  gatewayPaymentId  String?
  gatewayCheckoutUrl String?
  status            String   @default("pending") // pending, paid, cancelled, failed, refunded
  amount            Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Visit {
  id        Int      @id @default(autoincrement())
  path      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  gateway   String
  eventType String?
  payload   Json
  processed Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

// Linha única com as configurações editáveis do site pelo admin.
model Settings {
  id           Int      @id @default(1)
  discordUrl   String?
  whatsappUrl  String?
  contactEmail String?
  announcement String? // aviso opcional exibido no topo do site
  updatedAt    DateTime @updatedAt
}
